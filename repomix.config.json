{
  "output": {
    "filePath": "project.md",
    "style": "markdown",
    "removeComments": false,
    "removeEmptyLines": false,
    "showLineNumbers": false,
    "fileSummary": true,
    "directoryStructure": true
  },
  "include": [
    "src/**",
    ".storybook/**",
    "package.json",
    "tsconfig*.json",
    "vite.config.ts",
    "eslint.config.*",
    ".prettierrc*",
    "prettier.config.*",
    ".husky/*"
  ],
  "ignore": {
    "useGitignore": true,
    "useDefaultPatterns": true,
    "customPatterns": [
      "**/*.scss",
      "**/*.css",
      "**/*.svg",
      "**/*.png",
      "**/*.jpg",
      "**/*.jpeg",
      "**/*.woff",
      "**/*.woff2",
      "package-lock.json",
      "project.md",
      ".idea/**",
      "public/**"
    ]
  },
  "security": {
    "enableSecurityCheck": true
  }
}
